# Copy to .env.local for development. All values are public (they ship in the
# bundle); the service-role key must only ever live in the Worker's secrets.

# Supabase project used for sign-in, dynamic codes and scan analytics.
# Leave both empty to run QRx as a purely static generator.
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=

# Where the redirect Worker is reachable (no trailing slash). Dynamic QR codes
# encode <REACT_APP_REDIRECT_BASE>/<short_code>. Defaults to <SITE_URL>/r.
REACT_APP_REDIRECT_BASE=https://qrx.samita.in/r

# Optional link for the "Upgrade to Pro" buttons (a checkout page or mailto:).
# When empty the UI says Pro is coming soon.
REACT_APP_UPGRADE_URL=
